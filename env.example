# ── Database ────────────────────────────────────────────────────────────────
# Connessione Supabase (pooler). NON committare mai la stringa reale:
# questo file contiene solo un segnaposto.
DATABASE_URL="postgresql://postgres.<progetto>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# ── Accesso al pannello admin ───────────────────────────────────────────────
# La password non si salva in chiaro: genera l'hash con
#   node scripts/hash-password.mjs 'la-tua-password'
ADMIN_EMAIL="trattoriadapieromondello@gmail.com"
ADMIN_PASSWORD_HASH=""
# Segreto per firmare il cookie di sessione (minimo 32 caratteri).
# Lo stampa lo stesso comando qui sopra.
ADMIN_SESSION_SECRET=""

# ── Pagamenti Stripe ────────────────────────────────────────────────────────
# Senza queste chiavi l'e-commerce resta visibile ma gli ordini vengono solo
# registrati, da incassare a mano dal pannello.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL pubblico del sito, usato per le pagine di ritorno da Stripe.
NEXT_PUBLIC_SITE_URL="https://trattoriadapieromondello.site"

# Spese di spedizione in centesimi (0 = spedizione gratuita).
SHOP_SHIPPING_CENTS="0"
# Soglia in centesimi oltre la quale la spedizione è gratuita (0 = disattivata).
SHOP_FREE_SHIPPING_OVER_CENTS="0"

